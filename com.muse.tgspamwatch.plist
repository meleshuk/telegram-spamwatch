<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.muse.tgspamwatch</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.tgspamwatch/venv/bin/python</string>
        <string>__HOME__/.tgspamwatch/tg_spamwatch.py</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/.tgspamwatch/watcher.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.tgspamwatch/watcher.log</string>
</dict>
</plist>
